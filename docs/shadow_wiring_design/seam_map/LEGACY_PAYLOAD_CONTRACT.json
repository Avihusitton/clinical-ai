{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Legacy Payload Contract",
  "version": "1.0.0",
  "request_schema": {
    "type": "object",
    "required": ["question"],
    "properties": {
      "question": { "type": "string", "minLength": 1 },
      "modality": { "type": ["string", "null"], "enum": ["individual", "couples", "family", "general", null] }
    }
  },
  "response_schema": {
    "type": "string",
    "description": "Raw response string output generated by Retriever.answer()"
  },
  "error_contract": {
    "exceptions_propagated": ["Exception", "Neo4jError", "ValueError"],
    "shadow_isolation": "All shadow errors caught and logged without propagating to user caller"
  }
}
