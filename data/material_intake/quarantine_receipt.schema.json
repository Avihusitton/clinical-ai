{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clinical AI quarantined candidate receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {"type": ["string", "null"]},
    "source_document_id": {"type": ["string", "null"]},
    "source_sha256": {"type": ["string", "null"]},
    "source_authority": {"type": ["string", "null"]},
    "source_authority_basis": {"type": ["string", "null"]},
    "candidate_kind": {"type": ["string", "null"]},
    "anchor_card_ids": {
      "type": ["array", "null"],
      "items": {"type": "string"}
    },
    "pii_status": {"type": ["string", "null"]},
    "rights_status": {"type": ["string", "null"]},
    "route": {"const": "QUARANTINE"},
    "review_status": {"const": "BLOCKED"},
    "blocking_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "required": [
    "candidate_id",
    "source_document_id",
    "source_sha256",
    "source_authority",
    "source_authority_basis",
    "candidate_kind",
    "anchor_card_ids",
    "pii_status",
    "rights_status",
    "route",
    "review_status",
    "blocking_reasons"
  ]
}
