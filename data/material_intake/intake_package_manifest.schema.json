{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clinical AI dictionary intake package manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "package_id": {"type": "string", "pattern": "^PKG-[A-F0-9]{16}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": [
        "READY_FOR_DICTIONARY_VALIDATION",
        "BLOCKED_BY_SOURCE_REGISTRY"
      ]
    },
    "input_candidate_count": {"type": "integer", "minimum": 0},
    "source_document_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SRC-[A-F0-9]{16}$"}
    },
    "artifacts": {"type": "object"},
    "contract_artifacts": {"type": "object"},
    "route_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "DICTIONARY_CANONICAL_REVIEW": {"type": "integer", "minimum": 0},
        "DICTIONARY_SUPPLEMENTAL_REVIEW": {"type": "integer", "minimum": 0},
        "QUARANTINE": {"type": "integer", "minimum": 0}
      },
      "required": [
        "DICTIONARY_CANONICAL_REVIEW",
        "DICTIONARY_SUPPLEMENTAL_REVIEW",
        "QUARANTINE"
      ]
    },
    "automatic_promotions": {"const": 0},
    "neo4j_writes": {"const": 0}
  },
  "required": [
    "schema_version",
    "package_id",
    "generated_at",
    "status",
    "input_candidate_count",
    "source_document_ids",
    "artifacts",
    "contract_artifacts",
    "route_counts",
    "automatic_promotions",
    "neo4j_writes"
  ]
}
