# העתיקו קובץ זה ל-.env ומלאו את הערכים האמיתיים.
# setup.py עושה את ההעתקה הזו אוטומטית אם .env לא קיים.

# מפתח ה-API של OpenRouter (openrouter.ai -> Keys -> Create Key)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# מודל ברירת המחדל. deepseek/deepseek-v4-flash הוא הזול/המהיר מבין השניים.
# ודאו שהשם עדיין קיים ב-openrouter.ai/models לפני הרצה אמיתית - שמות מודלים
# משתנים עם הזמן.
LLM_MODEL=deepseek/deepseek-v4-flash

# פרטי החיבור ל-Neo4j (ברירת המחדל מתאימה להתקנה מקומית רגילה)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
